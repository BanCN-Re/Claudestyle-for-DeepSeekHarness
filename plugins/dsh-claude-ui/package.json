{
  "name": "dsh-claude-ui",
  "version": "1.0.0",
  "description": "Claude 桌面版式的 DSH 界面：侧栏 / 顶栏 / 输入框布局、两级模型切换器、额度小圆圈、可拖拽的右侧概览栏、运行状态行、步骤折叠、大尺寸设置窗口与动画。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
