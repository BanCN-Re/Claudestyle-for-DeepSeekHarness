{
  "name": "dsh-claude-theme",
  "version": "1.0.0",
  "description": "把 DSH 界面改成 Claude 桌面版风格：暖色中性底、陶土橙强调色、更柔和的输入框与气泡。浅色/深色都适配。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "theme"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "fonts", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
